# Fuentes

font_family      Maple Mono NF 
symbol_map U+E000-U+E00A,U+E0A0-U+E0C8,U+E0CA,U+E0CC-U+E0D7 Symbols Nerd Font
symbol_map U+E200-U+E2A9,U+E300-U+E3E3 Symbols Nerd Font
symbol_map U+E5FA-U+E6B5,U+E700-U+E7C5 Symbols Nerd Font
symbol_map U+EA60-U+EBEB,U+F000-U+F2E0 Symbols Nerd Font
symbol_map U+F300-U+F372,U+F400-U+F533 Symbols Nerd Font
symbol_map U+F0000-U+FFFFF Symbols Nerd Font

bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        14.0
disable_ligatures never

# ── Cursor ──────────────────────────────────
cursor_shape          block
cursor_blink_interval 0

# ── Ventana ──────────────────────────────────
background_opacity     0.95
window_padding_width 0

# ── Misc ─────────────────────────────────────
copy_on_select        yes
allow_remote_control  yes
shell_integration     enabled
confirm_os_window_close 0

# Nerd Fonts — forzar ancho de celdas PUA

# BEGIN_KITTY_THEME
# Noctalia
include current-theme.conf
# END_KITTY_THEME
